# ─────────────────────────────────────────────
#  bg-data-platform — .gitignore
# ─────────────────────────────────────────────

# Secrets & environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
pip-selfcheck.json
.python-version

# Build artifacts
staticfiles/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv/
uv.lock

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data files — NEVER commit scraped data
data/
!data/.gitkeep

# SQLite databases
*.db
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and reports
*.log
logs/
scraper_report.json
data_quality_report*.json

# Docker volumes
postgres_data/
redis_data/

# Alembic — keep migrations, not autogenerated cache
alembic/__pycache__/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Playwright
playwright/.auth/
