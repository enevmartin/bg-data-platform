# ─────────────────────────────────────────────
#  bg-data-platform  —  environment variables
#  Copy to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ──────────────────────────────────
# SQLite (dev default — leave DATABASE_URL unset to use SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./data/platform.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bg_data_platform
POSTGRES_USER=bgdata
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bg_data_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Storage ───────────────────────────────────
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ── Scraper settings ──────────────────────────
SCRAPER_USER_AGENT=bg-data-platform/1.0 (research crawler; contact: admin@example.com)
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_DOWNLOAD_TIMEOUT=300
SCRAPER_REQUEST_DELAY=1.5
SCRAPER_MAX_RETRIES=5
SCRAPER_MAX_FILE_SIZE_MB=200

# ── BNB ───────────────────────────────────────
BNB_BASE_URL=https://www.bnb.bg
BNB_STATISTICS_PATH=/en/Statistics/

# ── NSI ───────────────────────────────────────
NSI_BASE_URL=https://www.nsi.bg
NSI_STATISTICS_PATH=/en/content/

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
